<UserControl
    x:Class="Ferreteria.PuntoVenta.Views.Caja.ImpresorasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <Grid
            Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Margin="0,0,0,16">
                <TextBlock
                    Text="Impresoras"
                    Style="{StaticResource AppPanelTitleStyle}" />
                <TextBlock
                    Text="Configure la impresora de tickets y pruebe la conexión"
                    Style="{StaticResource AppPanelSubtitleStyle}" />
            </StackPanel>
            <UniformGrid
                Grid.Row="1"
                Columns="3"
                Margin="0,0,0,16">
                <Border
                    Style="{StaticResource AppStatCardStyle}"
                    Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock
                            Text="Predeterminada"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="DefaultNameText"
                            Text="Sin configurar"
                            Style="{StaticResource AppCardValueStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource AppStatCardStyle}"
                    Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock
                            Text="Ancho papel"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="DefaultPaperText"
                            Text="-"
                            Style="{StaticResource AppCardValueStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource AppStatCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="Estado"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="StatusText"
                            Text="Cargando..."
                            Style="{StaticResource AppCardValueStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Grid
                Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="1.3*" />
                    <ColumnDefinition
                        Width="0.9*" />
                </Grid.ColumnDefinitions>
                <Border
                    Background="{StaticResource AppAzulMedio}"
                    BorderBrush="{StaticResource AppAzulClaro}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppRadius_MD}"
                    Margin="0,0,12,0"
                    Padding="12">
                    <StackPanel>
                        <TextBlock
                            Text="Impresoras configuradas (toque una para editarla)"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <ListBox
                            x:Name="PrintersList"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,10,0,0"
                            SelectionChanged="OnPrinterSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Style="{StaticResource AppDataGridRowStyle}"
                                        Padding="8">
                                        <StackPanel>
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontSize="{StaticResource AppFontSize_LG}"
                                                Style="{StaticResource AppTableCellStyle}" />
                                            <TextBlock
                                                Text="{Binding ConnectionType}"
                                                FontSize="{StaticResource AppFontSize_LG}"
                                                Style="{StaticResource AppTableCellStyle}" />
                                            <TextBlock
                                                Text="{Binding PaperWidth, StringFormat={}{0} mm}"
                                                FontSize="{StaticResource AppFontSize_LG}"
                                                Style="{StaticResource AppTableCellStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock
                            Text="Impresoras detectadas en Windows"
                            Style="{StaticResource AppCardLabelStyle}"
                            Margin="0,16,0,4" />
                        <ListBox
                            x:Name="WindowsPrintersList"
                            Height="120"
                            FontSize="{StaticResource AppFontSize_LG}"
                            Background="Transparent"
                            Foreground="{StaticResource AppBlanco}"
                            BorderThickness="0" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="1"
                    Style="{StaticResource AppStatCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="Configuración"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            Text="Nombre de la impresora"
                            FontSize="{StaticResource AppFontSize_LG}"
                            Foreground="{StaticResource AppBlanco}"
                            Margin="0,8,0,4" />
                        <TextBox
                            x:Name="NameTextBox"
                            Style="{StaticResource AppFieldTextBoxStyle}"
                            FontSize="{StaticResource AppFontSize_LG}" />
                        <TextBlock
                            Text="Tipo de conexión"
                            FontSize="{StaticResource AppFontSize_LG}"
                            Foreground="{StaticResource AppBlanco}"
                            Margin="0,8,0,4" />
                        <ComboBox
                            x:Name="ConnectionCombo"
                            Style="{StaticResource AppFieldComboBoxStyle}"
                            FontSize="{StaticResource AppFontSize_LG}"
                            SelectedIndex="0"
                            SelectionChanged="OnConnectionChanged">
                            <ComboBoxItem
                                Content="USB (cola de Windows)"
                                Tag="USB" />
                            <ComboBoxItem
                                Content="Red (Ethernet)"
                                Tag="RED" />
                            <ComboBoxItem
                                Content="Bluetooth"
                                Tag="BLUETOOTH" />
                        </ComboBox>
                        <TextBlock
                            Text="Dirección IP (solo red)"
                            FontSize="{StaticResource AppFontSize_LG}"
                            Foreground="{StaticResource AppBlanco}"
                            Margin="0,8,0,4" />
                        <TextBox
                            x:Name="IpTextBox"
                            Style="{StaticResource AppFieldTextBoxStyle}"
                            FontSize="{StaticResource AppFontSize_LG}" />
                        <TextBlock
                            Text="Puerto (solo red)"
                            FontSize="{StaticResource AppFontSize_LG}"
                            Foreground="{StaticResource AppBlanco}"
                            Margin="0,8,0,4" />
                        <TextBox
                            x:Name="PortTextBox"
                            Style="{StaticResource AppFieldTextBoxStyle}"
                            FontSize="{StaticResource AppFontSize_LG}"
                            Text="9100" />
                        <TextBlock
                            Text="Ancho de papel"
                            FontSize="{StaticResource AppFontSize_LG}"
                            Foreground="{StaticResource AppBlanco}"
                            Margin="0,8,0,4" />
                        <ComboBox
                            x:Name="PaperCombo"
                            Style="{StaticResource AppFieldComboBoxStyle}"
                            FontSize="{StaticResource AppFontSize_LG}"
                            SelectedIndex="0">
                            <ComboBoxItem
                                Content="80 mm"
                                Tag="80" />
                            <ComboBoxItem
                                Content="58 mm"
                                Tag="58" />
                        </ComboBox>
                        <UniformGrid
                            Columns="2"
                            Margin="0,18,0,0">
                            <Button
                                Style="{StaticResource AppPrimaryWideButtonStyle}"
                                Width="Auto"
                                Height="90"
                                Margin="0,0,6,6"
                                Click="OnSaveClick">
                                <TextBlock
                                    Text="GUARDAR"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="{StaticResource AppFontSize_LG}"
                                    FontWeight="Bold"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button
                                Style="{StaticResource AppSecondaryWideButtonStyle}"
                                Width="Auto"
                                Height="90"
                                Margin="6,0,0,6"
                                Click="OnTestClick">
                                <TextBlock
                                    Text="PRUEBA"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="{StaticResource AppFontSize_LG}"
                                    FontWeight="Bold"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button
                                Style="{StaticResource AppSecondaryWideButtonStyle}"
                                Width="Auto"
                                Height="90"
                                Margin="0,6,6,0"
                                Click="OnPreviewClick">
                                <TextBlock
                                    Text="VISTA PREVIA"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="{StaticResource AppFontSize_LG}"
                                    FontWeight="Bold"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button
                                Style="{StaticResource AppSecondaryWideButtonStyle}"
                                Width="Auto"
                                Height="90"
                                Margin="6,6,0,0"
                                Click="OnSetDefaultClick">
                                <TextBlock
                                    Text="MARCAR PREDETERMINADA"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="{StaticResource AppFontSize_LG}"
                                    FontWeight="Bold"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
