<UserControl
    x:Class="Ferreteria.PuntoVenta.Views.Caja.CorteCajaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Ferreteria.PuntoVenta.Helpers"
    xmlns:local="clr-namespace:Ferreteria.PuntoVenta.Views.Caja"
    Loaded="OnLoaded">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <Grid
            Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel
                Margin="0,0,0,16">
                <TextBlock
                    Text="Corte de Caja"
                    Style="{StaticResource AppPanelTitleStyle}" />
                <TextBlock
                    Text="Resumen de turno, conciliación e impresión de cierre"
                    Style="{StaticResource AppPanelSubtitleStyle}" />
                <TextBlock
                    Text="Atajos: F5 actualizar · Esc cancelar/cerrar"
                    Style="{StaticResource AppPanelSubtitleStyle}"
                    AutomationProperties.HelpText="F5 actualiza el corte y Escape cancela o cierra la pantalla." />
                <TextBlock
                    x:Name="StatusText"
                    Style="{StaticResource AppPanelSubtitleStyle}"
                    Margin="0,8,0,0" />
            </StackPanel>
            <UniformGrid
                Grid.Row="1"
                Columns="5"
                Margin="0,0,0,16">
                <Border
                    Style="{StaticResource AppStatCardStyle}"
                    Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock
                            Text="Ventas"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="SalesText"
                            Text="$0.00"
                            Style="{StaticResource AppCardValueStyle}" />
                    </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource AppStatCardStyle}"
                    Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock
                            Text="Efectivo"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="CashText"
                            Text="$0.00"
                            Style="{StaticResource AppCardValueStyle}" />
                    </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource AppStatCardStyle}"
                    Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock
                            Text="Tarjeta"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="CardText"
                            Text="$0.00"
                            Style="{StaticResource AppCardValueStyle}" />
                    </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource AppStatCardStyle}"
                    Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock
                            Text="Transferencia"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="TransferText"
                            Text="$0.00"
                            Style="{StaticResource AppCardValueStyle}" />
                    </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource AppStatCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="DTEs"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="DteText"
                            Text="0"
                            Style="{StaticResource AppCardValueStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Grid
                Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="1.2*" />
                    <ColumnDefinition
                        Width="0.85*" />
                </Grid.ColumnDefinitions>
                <Border
                    Background="{StaticResource AppAzulMedio}"
                    BorderBrush="{StaticResource AppAzulClaro}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppRadius_MD}"
                    Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="40" />
                            <RowDefinition
                                Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            Style="{StaticResource AppGridHeaderStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="90" />
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="125" />
                                <ColumnDefinition
                                    Width="100" />
                                <ColumnDefinition
                                    Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="HORA"
                                Style="{StaticResource AppGridHeaderTextStyle}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="DOCUMENTO"
                                Style="{StaticResource AppGridHeaderTextStyle}" />
                            <TextBlock
                                Grid.Column="2"
                                Text="PAGO"
                                Style="{StaticResource AppGridHeaderTextStyle}" />
                            <TextBlock
                                Grid.Column="3"
                                Text="TOTAL"
                                Style="{StaticResource AppGridHeaderTextStyle}" />
                            <TextBlock
                                Grid.Column="4"
                                Text="ESTADO"
                                Style="{StaticResource AppGridHeaderTextStyle}" />
                        </Grid>
                        <ItemsControl
                            x:Name="MovementItemsControl"
                            Grid.Row="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Style="{StaticResource AppDataGridRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition
                                                    Width="90" />
                                                <ColumnDefinition
                                                    Width="*" />
                                                <ColumnDefinition
                                                    Width="125" />
                                                <ColumnDefinition
                                                    Width="100" />
                                                <ColumnDefinition
                                                    Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{Binding LocalTimeText}"
                                                Style="{StaticResource AppTableCellStyle}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding DocumentNumber}"
                                                TextTrimming="CharacterEllipsis"
                                                Style="{StaticResource AppTableCellStyle}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding PaymentMethod}"
                                                Style="{StaticResource AppTableCellStyle}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{Binding AmountText}"
                                                Style="{StaticResource AppTableCellStyle}" />
                                            <TextBlock
                                                Grid.Column="4"
                                                Text="{Binding Status}"
                                                Style="{StaticResource AppTableCellStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                <Border
                    Grid.Column="1"
                    Style="{StaticResource AppStatCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="Conciliación"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="SessionText"
                            Style="{StaticResource AppTableCellStyle}"
                            Margin="0,12,0,4" />
                        <local:NumericKeypad
                            x:Name="CashCountKeypad"
                            Precision="{x:Static helpers:FieldConstraints.CashSessionsClosingDeclaredAmountPrecision}"
                            Scale="{x:Static helpers:FieldConstraints.CashSessionsClosingDeclaredAmountScale}"
                            AllowNegative="False"
                            Margin="0,0,0,8" />
                        <Label
                            Content="Observaciones"
                            Target="{Binding ElementName=NotesTextBox}"
                            Style="{StaticResource AppFieldLabelStyle}" />
                        <TextBox
                            x:Name="NotesTextBox"
                            Style="{StaticResource AppFieldTextBoxStyle}"
                            helpers:WatermarkService.Watermark="Observaciones del cierre (opcional)"
                            Height="72"
                            TextWrapping="Wrap"
                            Margin="0,0,0,16" />
                        <TextBlock
                            x:Name="DifferenceText"
                            Text="Diferencia: aún no calculada"
                            Foreground="{StaticResource AppBlanco}"
                            FontSize="{StaticResource AppFontSize_LG}"
                            FontWeight="Bold"
                            TextWrapping="Wrap"
                            Margin="14,0,0,20" />
                        <Button
                            x:Name="CalculateButton"
                            Content="CALCULAR"
                            Style="{StaticResource AppSecondaryWideButtonStyle}"
                            MinHeight="90"
                            FontSize="16"
                            Margin="0,0,0,10"
                            Click="OnCalculateClick" />
                        <Button
                            x:Name="CloseButton"
                            Content="CERRAR TURNO"
                            Style="{StaticResource AppPrimaryWideButtonStyle}"
                            MinHeight="90"
                            FontSize="16"
                            IsEnabled="False"
                            Click="OnCloseClick" />
                        <Button
                            x:Name="ReprintButton"
                            Content="REIMPRIMIR REPORTE"
                            Style="{StaticResource AppSecondaryWideButtonStyle}"
                            MinHeight="90"
                            FontSize="16"
                            IsEnabled="False"
                            Margin="0,10,0,0"
                            Click="OnReprintClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
