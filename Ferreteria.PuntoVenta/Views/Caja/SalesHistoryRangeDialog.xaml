<Window
    x:Class="Ferreteria.PuntoVenta.Views.Caja.SalesHistoryRangeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rango de fechas"
    Width="520"
    Height="360"
    WindowStartupLocation="CenterOwner">
    <StackPanel
        Background="{StaticResource AppAzulOscuro}"
        Margin="24">
        <TextBlock
            Text="Rango de fechas"
            Style="{StaticResource AppPanelTitleStyle}" />
        <TextBlock
            Text="Ambas fechas son inclusivas y usan la hora local de El Salvador."
            Foreground="{StaticResource AppBlanco}"
            FontSize="16"
            Margin="0,8,0,16"
            TextWrapping="Wrap" />
        <TextBlock
            Text="Desde"
            Foreground="{StaticResource AppBlanco}"
            FontSize="16" />
        <DatePicker
            x:Name="FromPicker"
            FontSize="16"
            Margin="0,4,0,10" />
        <TextBlock
            Text="Hasta"
            Foreground="{StaticResource AppBlanco}"
            FontSize="16" />
        <DatePicker
            x:Name="ToPicker"
            FontSize="16"
            Margin="0,4,0,10" />
        <TextBlock
            x:Name="ValidationText"
            Foreground="{StaticResource AppWarning}"
            FontSize="16"
            Visibility="Collapsed"
            TextWrapping="Wrap" />
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                Content="CANCELAR"
                Style="{StaticResource AppSecondaryWideButtonStyle}"
                MinHeight="90"
                FontSize="16"
                Click="OnCancelClick" />
            <Button
                Content="ACEPTAR"
                Style="{StaticResource AppPrimaryWideButtonStyle}"
                MinHeight="90"
                FontSize="16"
                Click="OnAcceptClick" />
        </StackPanel>
    </StackPanel>
</Window>
