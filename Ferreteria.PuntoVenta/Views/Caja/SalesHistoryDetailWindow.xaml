<Window
    x:Class="Ferreteria.PuntoVenta.Views.Caja.SalesHistoryDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Detalle de venta"
    Width="1000"
    Height="760"
    WindowStartupLocation="CenterOwner">
    <DockPanel
        Background="{StaticResource AppAzulOscuro}"
        Margin="20">
        <Button
            DockPanel.Dock="Bottom"
            Content="CERRAR"
            Style="{StaticResource AppPrimaryWideButtonStyle}"
            MinHeight="90"
            FontSize="16"
            Click="OnCloseClick"
            HorizontalAlignment="Right" />
        <ScrollViewer
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                DataContext="{Binding}">
                <TextBlock
                    Text="Detalle de venta"
                    Style="{StaticResource AppPanelTitleStyle}" />
                <TextBlock
                    Text="{Binding HeaderText}"
                    Foreground="{StaticResource AppBlanco}"
                    FontSize="16"
                    Margin="0,8,0,16"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="LÍNEAS"
                    Style="{StaticResource AppPanelSubtitleStyle}" />
                <ItemsControl
                    ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="100" />
                                    <ColumnDefinition
                                        Width="110" />
                                    <ColumnDefinition
                                        Width="150" />
                                    <ColumnDefinition
                                        Width="130" />
                                    <ColumnDefinition
                                        Width="110" />
                                    <ColumnDefinition
                                        Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{Binding Product}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding QuantityText}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Unit}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding UnitsPerPackageText}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding UnitPriceText}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                                <TextBlock
                                    Grid.Column="5"
                                    Text="{Binding DiscountText}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                                <TextBlock
                                    Grid.Column="5"
                                    Text="{Binding SubtotalText}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Text="PAGOS"
                    Style="{StaticResource AppPanelSubtitleStyle}"
                    Margin="0,16,0,0" />
                <ItemsControl
                    ItemsSource="{Binding Payments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="220" />
                                    <ColumnDefinition
                                        Width="150" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{Binding Method}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding AmountText}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Reference}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Text="DTE Y NOTAS DE CRÉDITO"
                    Style="{StaticResource AppPanelSubtitleStyle}"
                    Margin="0,16,0,0" />
                <TextBlock
                    Text="{Binding NoDteText}"
                    Foreground="{StaticResource AppWarning}"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,4,0,4" />
                <ItemsControl
                    ItemsSource="{Binding Dtes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Margin="0,4,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="80" />
                                        <ColumnDefinition
                                            Width="280" />
                                        <ColumnDefinition
                                            Width="280" />
                                        <ColumnDefinition
                                            Width="150" />
                                        <ColumnDefinition
                                            Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding Type}"
                                        Foreground="{StaticResource AppBlanco}"
                                        FontSize="16" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding ControlNumber}"
                                        Foreground="{StaticResource AppBlanco}"
                                        FontSize="16"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding GenerationCode}"
                                        Foreground="{StaticResource AppBlanco}"
                                        FontSize="16"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding Status}"
                                        Foreground="{StaticResource AppBlanco}"
                                        FontSize="16" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{Binding Seal}"
                                        Foreground="{StaticResource AppBlanco}"
                                        FontSize="16"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock
                                    Text="NOTAS DE CRÉDITO"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16"
                                    Margin="20,6,0,2" />
                                <ItemsControl
                                    ItemsSource="{Binding CreditNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="20,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition
                                                        Width="80" />
                                                    <ColumnDefinition
                                                        Width="300" />
                                                    <ColumnDefinition
                                                        Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{Binding Type}"
                                                    Foreground="{StaticResource AppBlanco}"
                                                    FontSize="16" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding ControlNumber}"
                                                    Foreground="{StaticResource AppBlanco}"
                                                    FontSize="16" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{Binding Status}"
                                                    Foreground="{StaticResource AppBlanco}"
                                                    FontSize="16" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Text="MOVIMIENTOS DE INVENTARIO"
                    Style="{StaticResource AppPanelSubtitleStyle}"
                    Margin="0,16,0,0" />
                <ItemsControl
                    ItemsSource="{Binding Movements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="180" />
                                    <ColumnDefinition
                                        Width="130" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{Binding Product}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Type}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding QuantityText}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding Reason}"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="16"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Text="TOTALES Y NOTAS"
                    Style="{StaticResource AppPanelSubtitleStyle}"
                    Margin="0,16,0,0" />
                <TextBlock
                    Text="{Binding TotalsText}"
                    Foreground="{StaticResource AppBlanco}"
                    FontSize="16"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{Binding Notes}"
                    Foreground="{StaticResource AppBlanco}"
                    FontSize="16"
                    Margin="0,8,0,20"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
