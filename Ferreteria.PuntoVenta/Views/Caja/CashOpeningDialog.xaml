<Window
    x:Class="Ferreteria.PuntoVenta.Views.Caja.CashOpeningDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Ferreteria.PuntoVenta.Helpers"
    xmlns:local="clr-namespace:Ferreteria.PuntoVenta.Views.Caja"
    Title="Abrir caja"
    Style="{StaticResource AppDialogWindowStyle}"
    Width="620"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Loaded="OnLoaded"
    KeyDown="OnKeyDown">
    <Grid
        Margin="24"
        Background="{StaticResource AppAzulOscuro}"
        FocusManager.FocusedElement="{Binding ElementName=OpeningKeypad}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Text="Abrir caja"
            Foreground="{StaticResource AppBlanco}"
            FontSize="{StaticResource AppFontSize_XL}"
            FontWeight="Bold" />
        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,16"
            Text="Ingrese el fondo inicial en efectivo"
            Foreground="{StaticResource AppBlanco}"
            FontSize="{StaticResource AppFontSize_LG}" />
        <Label
            Grid.Row="2"
            Content="Fondo inicial"
            Target="{Binding ElementName=OpeningKeypad}"
            Style="{StaticResource RequiredLabelStyle}"
            helpers:FieldHelper.IsRequired="True"
            Margin="0,0,0,4" />
        <local:NumericKeypad
            x:Name="OpeningKeypad"
            Grid.Row="3"
            Precision="{x:Static helpers:FieldConstraints.CashSessionsOpeningAmountPrecision}"
            Scale="{x:Static helpers:FieldConstraints.CashSessionsOpeningAmountScale}"
            AllowNegative="False"
            TextChanged="OnAmountChanged"
            Margin="0,0,0,12" />
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label
                Content="Caja física"
                VerticalAlignment="Center"
                Foreground="{StaticResource AppBlanco}" />
            <!-- El código proviene de configuración; el límite permanece enlazado al esquema. -->
            <TextBox
                x:Name="CashRegisterCodeTextBox"
                Grid.Column="1"
                Text="{Binding CashRegisterCode, RelativeSource={RelativeSource AncestorType={x:Type local:CashOpeningDialog}}, Mode=OneWay}"
                IsReadOnly="True"
                MaxLength="{x:Static helpers:FieldConstraints.CashSessionsCashRegisterCodeMaxLength}"
                Style="{StaticResource AppFieldTextBoxStyle}"
                Margin="12,0,0,0"
                AutomationProperties.Name="Código de caja configurado" />
        </Grid>
        <StackPanel Grid.Row="5">
            <Label
                Content="Observación (opcional)"
                Target="{Binding ElementName=NotesTextBox}"
                Foreground="{StaticResource AppBlanco}"
                Margin="0,0,0,4" />
            <TextBox
                x:Name="NotesTextBox"
                Height="64"
                FontSize="16"
                Style="{StaticResource AppFieldTextBoxStyle}"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                Margin="0,0,0,8"
                helpers:WatermarkService.Watermark="Observación de apertura (opcional)" />
            <TextBlock
                x:Name="ErrorText"
                Foreground="{StaticResource AppError}"
                FontSize="16"
                TextWrapping="Wrap"
                Margin="0,0,0,8" />
        </StackPanel>
        <Grid Grid.Row="8" Style="{StaticResource AppDialogFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Style="{StaticResource AppActionButtonSecondaryStyle}"
                    IsCancel="True"
                    Click="OnCancelClick"
                    Content="CANCELAR"
                    AutomationProperties.Name="Cancelar apertura de caja" />
                <Button
                    Grid.Column="1"
                    Style="{StaticResource AppActionButtonStyle}"
                    IsDefault="True"
                    Click="OnConfirmClick"
                    Content="ABRIR CAJA"
                    AutomationProperties.Name="Abrir caja" />
        </Grid>
    </Grid>
</Window>
