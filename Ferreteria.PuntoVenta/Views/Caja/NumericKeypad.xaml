<UserControl
    x:Class="Ferreteria.PuntoVenta.Views.Caja.NumericKeypad"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Ferreteria.PuntoVenta.Helpers"
    xmlns:local="clr-namespace:Ferreteria.PuntoVenta.Views.Caja">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="64" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="90" />
        </Grid.RowDefinitions>
        <TextBox
            x:Name="InputTextBox"
            Style="{StaticResource AppFieldTextBoxStyle}"
            helpers:NumericInput.IsEnabled="True"
            helpers:NumericInput.Precision="{Binding Precision, RelativeSource={RelativeSource AncestorType={x:Type local:NumericKeypad}}}"
            helpers:NumericInput.Scale="{Binding Scale, RelativeSource={RelativeSource AncestorType={x:Type local:NumericKeypad}}}"
            helpers:NumericInput.AllowNegative="{Binding AllowNegative, RelativeSource={RelativeSource AncestorType={x:Type local:NumericKeypad}}}"
            HorizontalContentAlignment="Right"
            FontSize="28"
            Text="0"
            Margin="0,0,0,12" />
        <TextBlock
            Grid.Row="1"
            Text="{Binding (helpers:NumericInput.ErrorMessage), ElementName=InputTextBox}"
            Foreground="{StaticResource AppError}"
            TextWrapping="Wrap"
            Margin="0,0,0,12"
            AutomationProperties.LiveSetting="Assertive">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding (helpers:NumericInput.ErrorMessage), ElementName=InputTextBox}"
                            Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding (helpers:NumericInput.ErrorMessage), ElementName=InputTextBox}"
                            Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <UniformGrid
            Grid.Row="2"
            Columns="3"
            Margin="0,0,0,12">
            <Button
                Tag="1"
                MinWidth="90"
                MinHeight="90"
                FontSize="24"
                Click="OnDigitClick"
                Content="1" />
            <Button
                Tag="2"
                MinWidth="90"
                MinHeight="90"
                FontSize="24"
                Click="OnDigitClick"
                Content="2" />
            <Button
                Tag="3"
                MinWidth="90"
                MinHeight="90"
                FontSize="24"
                Click="OnDigitClick"
                Content="3" />
            <Button
                Tag="4"
                MinWidth="90"
                MinHeight="90"
                FontSize="24"
                Click="OnDigitClick"
                Content="4" />
            <Button
                Tag="5"
                MinWidth="90"
                MinHeight="90"
                FontSize="24"
                Click="OnDigitClick"
                Content="5" />
            <Button
                Tag="6"
                MinWidth="90"
                MinHeight="90"
                FontSize="24"
                Click="OnDigitClick"
                Content="6" />
            <Button
                Tag="7"
                MinWidth="90"
                MinHeight="90"
                FontSize="24"
                Click="OnDigitClick"
                Content="7" />
            <Button
                Tag="8"
                MinWidth="90"
                MinHeight="90"
                FontSize="24"
                Click="OnDigitClick"
                Content="8" />
            <Button
                Tag="9"
                MinWidth="90"
                MinHeight="90"
                FontSize="24"
                Click="OnDigitClick"
                Content="9" />
            <Button
                x:Name="DecimalButton"
                Tag="DECIMAL"
                MinWidth="90"
                MinHeight="90"
                FontSize="24"
                Click="OnCommandClick"
                Content=".">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding Scale, RelativeSource={RelativeSource AncestorType={x:Type local:NumericKeypad}}}"
                                Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button
                Tag="0"
                MinWidth="90"
                MinHeight="90"
                FontSize="24"
                Click="OnDigitClick"
                Content="0" />
            <Button
                Tag="BACKSPACE"
                MinWidth="90"
                MinHeight="90"
                FontSize="20"
                Click="OnCommandClick"
                Content="BORRAR" />
        </UniformGrid>
        <Button
            Grid.Row="3"
            MinHeight="90"
            FontSize="20"
            Click="OnCommandClick"
            Tag="CLEAR"
            Content="LIMPIAR" />
    </Grid>
</UserControl>
