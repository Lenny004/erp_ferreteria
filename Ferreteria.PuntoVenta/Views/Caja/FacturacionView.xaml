<UserControl
    x:Class="Ferreteria.PuntoVenta.Views.Caja.FacturacionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Ferreteria.PuntoVenta.Helpers"
    xmlns:local="clr-namespace:Ferreteria.PuntoVenta.Views.Caja"
    FocusManager.FocusedElement="{Binding ElementName=ProductSearchTextBox}">
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static local:FacturacionView.FocusProductSearchCommand}" Executed="OnFocusProductSearchCommandExecuted" />
        <CommandBinding Command="{x:Static local:FacturacionView.ChargeSaleCommand}" CanExecute="OnChargeSaleCommandCanExecute" Executed="OnChargeSaleCommandExecuted" />
        <CommandBinding Command="{x:Static local:FacturacionView.CancelSaleCommand}" Executed="OnCancelSaleCommandExecuted" />
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{x:Static local:FacturacionView.FocusProductSearchCommand}" />
        <KeyBinding Key="F9" Command="{x:Static local:FacturacionView.ChargeSaleCommand}" />
        <KeyBinding Key="Escape" Command="{x:Static local:FacturacionView.CancelSaleCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="500" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Facturación" Style="{StaticResource AppPanelTitleStyle}" />
                <TextBlock Text="Crear orden, emitir DTE y preparar impresión de ticket" Style="{StaticResource AppPanelSubtitleStyle}" />
            </StackPanel>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource AppStatCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <Label Content="Tipo de documento" Target="{Binding ElementName=DteTypeCombo}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                        <ComboBox x:Name="DteTypeCombo" Style="{StaticResource AppFieldComboBoxStyle}" SelectedIndex="0" Margin="0,4,0,0" SelectionChanged="OnDteTypeChanged" TabIndex="0" AutomationProperties.Name="Tipo de documento obligatorio">
                            <ComboBoxItem Content="01 Factura" Tag="01" />
                            <ComboBoxItem Content="03 Crédito fiscal" Tag="03" />
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AppStatCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <Label Content="Método de pago" Target="{Binding ElementName=PaymentMethodCombo}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                        <ComboBox x:Name="PaymentMethodCombo" Style="{StaticResource AppFieldComboBoxStyle}" SelectedIndex="0" Margin="0,4,0,0" TabIndex="1" AutomationProperties.Name="Método de pago obligatorio">
                            <ComboBoxItem Content="Efectivo" Tag="EFECTIVO" />
                            <ComboBoxItem Content="Tarjeta" Tag="TARJETA" />
                            <ComboBoxItem Content="Transferencia" Tag="TRANSFERENCIA" />
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AppStatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total a facturar" Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock x:Name="HeaderTotalText" Text="$0.00" Style="{StaticResource AppCardValueStyle}" Foreground="{StaticResource AppSuccess}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource AppStatCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <Label Content="Buscar producto (F2)" Target="{Binding ElementName=ProductSearchTextBox}" Foreground="{StaticResource AppBlanco}" AutomationProperties.AcceleratorKey="F2" />
                        <TextBox x:Name="ProductSearchTextBox" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Código o descripción" Margin="0,4,0,8" TextChanged="OnProductSearchChanged" GotFocus="OnProductSearchGotFocus" TabIndex="2" AutomationProperties.Name="Buscar producto" AutomationProperties.AcceleratorKey="F2" />
                        <Label Content="Cantidad" Target="{Binding ElementName=QuantityTextBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                        <TextBox x:Name="QuantityTextBox" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Cantidad" helpers:NumericInput.IsEnabled="True" helpers:NumericInput.Precision="{x:Static helpers:FieldConstraints.OrderDetailQuantityPrecision}" helpers:NumericInput.Scale="{x:Static helpers:FieldConstraints.OrderDetailQuantityScale}" Text="1" Margin="0,4,0,0" TabIndex="3" AutomationProperties.Name="Cantidad obligatoria" />
                        <TextBlock Text="{Binding ElementName=QuantityTextBox, Path=(helpers:NumericInput.ErrorMessage)}" Foreground="{StaticResource AppError}" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.LiveSetting="Assertive" />
                        <Button Content="AGREGAR" Style="{StaticResource AppActionButtonStyle}" Click="OnAgregarClick" TabIndex="4" AutomationProperties.Name="Agregar producto al carrito" />
                        <Rectangle Height="1" Fill="{StaticResource AppAzulClaro}" Margin="0,16" />
                        <TextBlock Text="Resultados" Style="{StaticResource AppCardLabelStyle}" />
                        <ListBox x:Name="ProductResultsListBox" Background="Transparent" BorderThickness="0" MaxHeight="220" Margin="0,10,0,0" Visibility="Collapsed" TabIndex="5" AutomationProperties.Name="Resultados de productos">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Code}" Style="{StaticResource AppTableCellStyle}" Foreground="{StaticResource AppRojo}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource AppTableCellStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding FormattedStock}" Style="{StaticResource AppTableCellStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource AppStatCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Detalle de orden" Style="{StaticResource AppCardLabelStyle}" />
                        <ItemsControl x:Name="CartItemsControl" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AppDataGridRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource AppTableCellStyle}" TextWrapping="Wrap" ToolTip="{Binding Description}" />
                                            <TextBlock Grid.Column="1" Text="{Binding QuantityText}" Style="{StaticResource AppTableCellStyle}" />
                                            <TextBlock Grid.Column="2" Text="{Binding UnitPriceText}" Style="{StaticResource AppTableCellStyle}" />
                                            <TextBlock Grid.Column="3" Text="{Binding SubtotalText}" Style="{StaticResource AppTableCellStyle}" />
                                            <Button Grid.Column="4" Content="X" Width="26" Height="24" Style="{StaticResource AppWindowButtonStyle}" Click="OnRemoveCartLineClick" AutomationProperties.Name="Quitar línea del carrito" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource AppStatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Cliente" Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock x:Name="SelectedCustomerText" Text="Consumidor final" Foreground="{StaticResource AppBlanco}" TextWrapping="Wrap" Margin="0,8,0,4" />
                        <Button Content="VOLVER A CONSUMIDOR FINAL" Style="{StaticResource AppActionButtonSecondaryStyle}" Click="OnUseWalkInCustomerClick" TabIndex="6" AutomationProperties.Name="Volver a consumidor final" />
                        <Label Content="Buscar cliente" Target="{Binding ElementName=CustomerSearchTextBox}" Foreground="{StaticResource AppBlanco}" Margin="0,12,0,0" />
                        <TextBox x:Name="CustomerSearchTextBox" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Nombre, NIT, NRC o DUI" TextChanged="OnCustomerSearchChanged" GotFocus="OnCustomerSearchGotFocus" TabIndex="7" AutomationProperties.Name="Buscar cliente por nombre, NIT, NRC o DUI" />
                        <ListBox x:Name="CustomerResultsListBox" Background="Transparent" BorderThickness="0" MaxHeight="150" Margin="0,8,0,0" Visibility="Collapsed" SelectionChanged="OnCustomerSelected" TabIndex="8" AutomationProperties.Name="Resultados de clientes">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource AppTableCellStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Nit}" Style="{StaticResource AppTableCellStyle}" />
                                        <TextBlock Text="{Binding Nrc}" Style="{StaticResource AppTableCellStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="CREAR CLIENTE" Style="{StaticResource AppActionButtonStyle}" Margin="0,8,0,0" Click="OnCreateCustomerClick" TabIndex="9" AutomationProperties.Name="Crear cliente" />
                        <TextBlock x:Name="CustomerRequirementText" Text="Factura: cliente opcional." Foreground="{StaticResource AppGrisClaro}" TextWrapping="Wrap" Margin="0,8,0,16" />
                        <TextBlock x:Name="SubtotalText" Text="Subtotal: $0.00" Style="{StaticResource AppTableCellStyle}" Margin="0,0,0,6" />
                        <TextBlock x:Name="TaxText" Text="IVA: $0.00" Style="{StaticResource AppTableCellStyle}" Margin="0,0,0,6" />
                        <TextBlock x:Name="TotalText" Text="Total: $0.00" Foreground="{StaticResource AppSuccess}" FontSize="{StaticResource AppFontSize_XL}" FontWeight="Bold" Margin="14,6,0,20" />
                        <Button x:Name="FacturarButton" Content="COBRAR (F9)" Style="{StaticResource AppPrimaryWideButtonStyle}" Click="OnFacturarClick" TabIndex="10" AutomationProperties.Name="Cobrar venta" AutomationProperties.AcceleratorKey="F9" />
                        <Button Content="IMPRIMIR ÚLTIMO TICKET" Style="{StaticResource AppSecondaryWideButtonStyle}" Margin="0,10,0,0" Click="OnPrintLastClick" TabIndex="11" AutomationProperties.Name="Imprimir último ticket" />
                        <Button Content="LIMPIAR VENTA" Style="{StaticResource AppSecondaryWideButtonStyle}" Margin="0,10,0,0" Click="OnLimpiarClick" TabIndex="12" AutomationProperties.Name="Limpiar venta" />
                        <TextBlock x:Name="StatusText" Text="" Style="{StaticResource AppTableCellStyle}" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Atajos: F2 buscar · F9 cobrar · Esc cerrar búsqueda o cancelar venta" Foreground="{StaticResource AppGrisClaro}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
