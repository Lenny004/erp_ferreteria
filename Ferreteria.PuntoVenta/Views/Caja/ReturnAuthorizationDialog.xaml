<Window x:Class="Ferreteria.PuntoVenta.Views.Caja.ReturnAuthorizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorizar devolución" Width="420" Height="230" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#172A46">
    <StackPanel Margin="24">
        <TextBlock Text="PIN del autorizador" Foreground="White" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Ingrese el PIN de un Administrador." Foreground="White" Margin="0,8,0,12" />
        <PasswordBox x:Name="PinBox" MaxLength="4" FontSize="24" Height="42" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="CANCELAR" Width="110" Height="42" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Content="ACEPTAR" Width="110" Height="42" Click="OnAcceptClick" />
        </StackPanel>
    </StackPanel>
</Window>
