<Window
    x:Class="Ferreteria.PuntoVenta.Views.Caja.PrintFailureDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Impresión de ticket"
    Width="640"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    KeyDown="OnKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/Resources/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid
        Background="{StaticResource AppAzulOscuro}">
        <Grid
            Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock
                Text="La venta se guardó, pero no se pudo imprimir."
                Foreground="{StaticResource AppBlanco}"
                FontSize="{StaticResource AppFontSize_XL}"
                FontWeight="Bold"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ReasonText"
                Margin="0,18,0,0"
                Foreground="{StaticResource AppBlanco}"
                FontSize="{StaticResource AppFontSize_LG}"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Margin="0,24,0,0"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                Style="{StaticResource AppPrimaryWideButtonStyle}"
                Width="200"
                Height="90"
                Margin="0,0,12,0"
                IsDefault="True"
                Click="OnRetryClick">
                <TextBlock
                    Text="REINTENTAR"
                    Foreground="{StaticResource AppBlanco}"
                    FontSize="{StaticResource AppFontSize_LG}"
                    FontWeight="Bold" />
            </Button>
            <Button
                Style="{StaticResource AppSecondaryWideButtonStyle}"
                Width="200"
                Height="90"
                IsCancel="True"
                Click="OnContinueClick">
                <TextBlock
                    Text="CONTINUAR"
                    Foreground="{StaticResource AppBlanco}"
                    FontSize="{StaticResource AppFontSize_LG}"
                    FontWeight="Bold" />
            </Button>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
