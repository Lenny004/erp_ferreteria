<UserControl
    x:Class="Ferreteria.PuntoVenta.Views.Inventario.ProveedoresView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Ferreteria.PuntoVenta.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Lista -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Proveedores" Style="{StaticResource AppPanelTitleStyle}" />
                <TextBlock Text="Gestione los proveedores de la ferreteria" Style="{StaticResource AppPanelSubtitleStyle}" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchTextBox"
                    Style="{StaticResource AppFieldTextBoxStyle}"
                    helpers:WatermarkService.Watermark="Buscar por nombre o NIT"
                    TextChanged="OnSearchChanged" />
                <Button
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Style="{StaticResource AppSecondaryWideButtonStyle}"
                    Click="OnNuevoClick">
                    <TextBlock Text="NUEVO" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                </Button>
            </Grid>
            <Border
                Grid.Row="2"
                Background="{StaticResource AppAzulMedio}"
                BorderBrush="{StaticResource AppAzulClaro}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppRadius_MD}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Style="{StaticResource AppGridHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NOMBRE" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="NIT" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="TELEFONO" Style="{StaticResource AppGridHeaderTextStyle}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock
                            x:Name="EmptyStateText"
                            Text="Sin proveedores para mostrar."
                            Style="{StaticResource AppTableCellStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AppDataGridRowButtonStyle}"
                                                Click="OnRowClick"
                                                Tag="{Binding Id}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource AppTableCellStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Nit}" Style="{StaticResource AppTableCellStyle}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Phone}" Style="{StaticResource AppTableCellStyle}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Formulario -->
        <Border
            Grid.Column="1"
            Background="{StaticResource AppAzulMedio}"
            BorderBrush="{StaticResource AppAzulClaro}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppRadius_MD}"
            Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="Nuevo proveedor" Style="{StaticResource AppPanelTitleStyle}" Margin="0,0,0,12" />

                    <Label Content="Nombre / Razón social" Target="{Binding ElementName=NameBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <TextBox x:Name="NameBox" MaxLength="{x:Static helpers:FieldConstraints.Suppliers.NameMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Razón social" Margin="0,4,0,10" />

                    <Label Content="Nombre comercial" Target="{Binding ElementName=TradeNameBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="TradeNameBox" MaxLength="{x:Static helpers:FieldConstraints.Suppliers.TradeNameMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Nombre comercial (opcional)" Margin="0,4,0,10" />

                    <Label Content="NIT" Target="{Binding ElementName=NitBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="NitBox" MaxLength="{x:Static helpers:FieldConstraints.Suppliers.NitMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="NIT (opcional)" Margin="0,4,0,10" />

                    <Label Content="NRC" Target="{Binding ElementName=NrcBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="NrcBox" MaxLength="{x:Static helpers:FieldConstraints.Suppliers.NrcMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="NRC (opcional)" Margin="0,4,0,10" />

                    <Label Content="Contacto" Target="{Binding ElementName=ContactBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="ContactBox" MaxLength="{x:Static helpers:FieldConstraints.Suppliers.ContactNameMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Persona de contacto" Margin="0,4,0,10" />

                    <Label Content="Teléfono" Target="{Binding ElementName=PhoneBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="PhoneBox" MaxLength="{x:Static helpers:FieldConstraints.Suppliers.PhoneMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Teléfono (opcional)" Margin="0,4,0,10" />

                    <Label Content="Correo" Target="{Binding ElementName=EmailBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="EmailBox" MaxLength="{x:Static helpers:FieldConstraints.Suppliers.EmailMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="correo@ejemplo.com" Margin="0,4,0,10" />

                    <Label Content="Dirección" Target="{Binding ElementName=AddressBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="AddressBox" MaxLength="{x:Static helpers:FieldConstraints.Suppliers.AddressMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Dirección (opcional)" Margin="0,4,0,10" />

                    <Label Content="País" Target="{Binding ElementName=CountryBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <TextBox x:Name="CountryBox" Text="SV — asignado automáticamente" IsReadOnly="True" Style="{StaticResource AppFieldTextBoxStyle}" Margin="0,4,0,10" AutomationProperties.Name="País del proveedor" />

                    <Label Content="Días de crédito" Target="{Binding ElementName=CreditDaysBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="CreditDaysBox" Text="0" Style="{StaticResource AppFieldTextBoxStyle}" helpers:NumericInput.IsEnabled="True" helpers:NumericInput.Precision="9" helpers:NumericInput.Scale="0" helpers:WatermarkService.Watermark="0" Margin="0,4,0,10" />

                    <Label Content="Notas" Target="{Binding ElementName=NotesBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="NotesBox" Style="{StaticResource AppFieldTextBoxStyle}"
                             helpers:WatermarkService.Watermark="Notas internas (opcional)" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,4,0,10" />

                    <TextBlock x:Name="FormErrorText" Foreground="{StaticResource AppError}"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource AppPrimaryWideButtonStyle}" Click="OnGuardarClick" Margin="0,0,6,0">
                            <TextBlock Text="GUARDAR" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource AppSecondaryWideButtonStyle}" Click="OnCancelarClick" Margin="6,0,0,0">
                            <TextBlock Text="LIMPIAR" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                        </Button>
                    </Grid>
                    <Button x:Name="DeactivateButton" Style="{StaticResource AppSecondaryWideButtonStyle}"
                            Click="OnDesactivarClick" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Text="DESACTIVAR" Foreground="{StaticResource AppError}" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
