<UserControl
    x:Class="Ferreteria.PuntoVenta.Views.Inventario.ProductosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Ferreteria.PuntoVenta.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Lista -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Catalogo de Productos" Style="{StaticResource AppPanelTitleStyle}" />
                <TextBlock Text="Alta, edicion y baja de productos de ferreteria" Style="{StaticResource AppPanelSubtitleStyle}" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchTextBox"
                    Style="{StaticResource AppFieldTextBoxStyle}"
                    helpers:WatermarkService.Watermark="Buscar codigo, descripcion o categoria"
                    TextChanged="OnSearchChanged" />
                <Button
                    x:Name="NewButton"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Style="{StaticResource AppSecondaryWideButtonStyle}"
                    Click="OnNuevoClick">
                    <TextBlock Text="NUEVO" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                </Button>
            </Grid>
            <Border
                Grid.Row="2"
                Background="{StaticResource AppAzulMedio}"
                BorderBrush="{StaticResource AppAzulClaro}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppRadius_MD}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Style="{StaticResource AppGridHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CODIGO" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="DESCRIPCION" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="STOCK" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="PRECIO" Style="{StaticResource AppGridHeaderTextStyle}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock
                            x:Name="EmptyStateText"
                            Text="Sin productos para mostrar."
                            Style="{StaticResource AppTableCellStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AppDataGridRowButtonStyle}"
                                                Click="OnRowClick"
                                                Tag="{Binding Id}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Code}" Style="{StaticResource AppTableCellStyle}" Foreground="{StaticResource AppRojo}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" ToolTip="{Binding Description}" TextTrimming="CharacterEllipsis" Style="{StaticResource AppTableCellStyle}" />
                                                <TextBlock Grid.Column="2" Text="{Binding CurrentStock}" Style="{StaticResource AppTableCellStyle}" />
                                                <TextBlock Grid.Column="3" Text="{Binding SalePrice}" ToolTip="{Binding SalePrice}" Style="{StaticResource AppTableCellStyle}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Formulario -->
        <Border
            Grid.Column="1"
            Background="{StaticResource AppAzulMedio}"
            BorderBrush="{StaticResource AppAzulClaro}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppRadius_MD}"
            Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EditorPanel">
                    <TextBlock x:Name="FormTitle" Text="Nuevo producto" Style="{StaticResource AppPanelTitleStyle}" Margin="0,0,0,12" />

                    <Label Content="Código" Target="{Binding ElementName=CodeBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <TextBox x:Name="CodeBox" MaxLength="{x:Static helpers:FieldConstraints.Products.CodeMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Código interno del producto" Margin="0,4,0,10" />

                    <Label Content="Código de barras" Target="{Binding ElementName=BarcodeBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="BarcodeBox" MaxLength="{x:Static helpers:FieldConstraints.Products.BarcodeMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Código de barras (opcional)" Margin="0,4,0,10" />

                    <Label Content="Descripción" Target="{Binding ElementName=DescriptionBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <TextBox x:Name="DescriptionBox" MaxLength="{x:Static helpers:FieldConstraints.Products.DescriptionMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Descripción comercial" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <Label Content="Categoría" Target="{Binding ElementName=FamilyCombo}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <ComboBox x:Name="FamilyCombo" Style="{StaticResource AppFieldComboBoxStyle}"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="OnFamilyChanged" Margin="0,4,0,10" />

                    <Label Content="Subcategoría" Target="{Binding ElementName=SubfamilyCombo}" Style="{StaticResource AppFieldLabelStyle}" />
                    <ComboBox x:Name="SubfamilyCombo" Style="{StaticResource AppFieldComboBoxStyle}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,10" />

                    <Label Content="Unidad de medida" Target="{Binding ElementName=MeasurementCombo}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <ComboBox x:Name="MeasurementCombo" Style="{StaticResource AppFieldComboBoxStyle}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,10" />

                    <Label Content="Proveedor" Target="{Binding ElementName=SupplierCombo}" Style="{StaticResource AppFieldLabelStyle}" />
                    <ComboBox x:Name="SupplierCombo" Style="{StaticResource AppFieldComboBoxStyle}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <Label Content="Precio de venta" Target="{Binding ElementName=SalePriceBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                            <TextBox x:Name="SalePriceBox" Text="0" Style="{StaticResource AppFieldTextBoxStyle}" helpers:NumericInput.IsEnabled="True" helpers:NumericInput.Precision="{x:Static helpers:FieldConstraints.Products.SalePricePrecision}" helpers:NumericInput.Scale="{x:Static helpers:FieldConstraints.Products.SalePriceScale}" helpers:WatermarkService.Watermark="0,00" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <Label Content="Costo" Target="{Binding ElementName=CostPriceBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                            <TextBox x:Name="CostPriceBox" Text="0" Style="{StaticResource AppFieldTextBoxStyle}" helpers:NumericInput.IsEnabled="True" helpers:NumericInput.Precision="{x:Static helpers:FieldConstraints.Products.CostPricePrecision}" helpers:NumericInput.Scale="{x:Static helpers:FieldConstraints.Products.CostPriceScale}" helpers:WatermarkService.Watermark="0,0000" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <Label x:Name="StockLabel" Content="Stock inicial" Target="{Binding ElementName=StockBox}" Style="{StaticResource AppFieldLabelStyle}" />
                            <TextBox x:Name="StockBox" Text="0" Style="{StaticResource AppFieldTextBoxStyle}" helpers:NumericInput.IsEnabled="True" helpers:NumericInput.Precision="{x:Static helpers:FieldConstraints.Products.CurrentStockPrecision}" helpers:NumericInput.Scale="{x:Static helpers:FieldConstraints.Products.CurrentStockScale}" helpers:WatermarkService.Watermark="0,000" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <Label Content="Stock mínimo" Target="{Binding ElementName=MinStockBox}" Style="{StaticResource AppFieldLabelStyle}" />
                            <TextBox x:Name="MinStockBox" Text="0" Style="{StaticResource AppFieldTextBoxStyle}" helpers:NumericInput.IsEnabled="True" helpers:NumericInput.Precision="{x:Static helpers:FieldConstraints.Products.MinStockPrecision}" helpers:NumericInput.Scale="{x:Static helpers:FieldConstraints.Products.MinStockScale}" helpers:WatermarkService.Watermark="0,000" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Label Content="Notas" Target="{Binding ElementName=NotesBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="NotesBox" Style="{StaticResource AppFieldTextBoxStyle}"
                             helpers:WatermarkService.Watermark="Notas internas (opcional)" TextWrapping="Wrap" AcceptsReturn="True" Height="50" Margin="0,4,0,10" />

                    <TextBlock x:Name="FormErrorText" Foreground="{StaticResource AppError}"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SaveButton" Style="{StaticResource AppPrimaryWideButtonStyle}" Click="OnGuardarClick" Margin="0,0,6,0">
                            <TextBlock Text="GUARDAR" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource AppSecondaryWideButtonStyle}" Click="OnCancelarClick" Margin="6,0,0,0">
                            <TextBlock Text="LIMPIAR" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                        </Button>
                    </Grid>
                    <Button x:Name="DeactivateButton" Style="{StaticResource AppSecondaryWideButtonStyle}"
                            Click="OnDesactivarClick" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Text="DESACTIVAR" Foreground="{StaticResource AppError}" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
